# Firebase Realtime Database Configuration
# Hubungkan ke Realtime Database Anda (Region Default atau Singapore)
FIREBASE_DATABASE_URL=your-firebase-db-url-here

# (Opsional) Jika database Anda diproteksi dengan aturan read/write rules:
FIREBASE_DATABASE_SECRET=your-firebase-db-secret-here

# Secret Key untuk masuk ke Dashboard Developer Monitor (?key=...)
ADMIN_SECRET_KEY=your-admin-secret-key-here

# Vercel KV REST API fallback (jika tidak menggunakan Firebase)
KV_REST_API_URL=
KV_REST_API_TOKEN=
